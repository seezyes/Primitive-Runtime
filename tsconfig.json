{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "rootDir": "packages",
    "outDir": "dist",
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "packages/**/*.ts"
  ]
}
